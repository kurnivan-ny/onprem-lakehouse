# Copy to .env (`make init` does it). Local dev values - change every secret before
# putting this on a shared server. .env is git-ignored.

# ---------- storage (RustFS) ----------
RUSTFS_ACCESS_KEY=lake-dev
RUSTFS_SECRET_KEY=lake-dev-secret-change-me
LAKE_BUCKET=lakehouse

# ---------- Iceberg catalog (Lakekeeper) ----------
ICEBERG_WAREHOUSE=lakehouse
LAKEKEEPER_ENCRYPTION_KEY=change-me-32-chars-minimum-please!!
LAKEKEEPER_DB_PASSWORD=lakekeeper_dev_pw

# ---------- platform metadata Postgres ----------
PLATFORM_DB_PASSWORD=platform_dev_pw

# ---------- batch: source OLTP ----------
PG_DB=shop
PG_USER=shop
PG_PASSWORD=shop_dev_pw
SPARK_DRIVER_MEMORY=2g

# ---------- event: Kafka topics + producer ----------
TOPIC_EVENTS=orders.events
TOPIC_DLQ=orders.dlq
EVENTS_PER_SEC=5
BAD_EVENT_RATE=0.02
DUPLICATE_RATE=0.01

# ---------- serving: Superset ----------
SUPERSET_SECRET_KEY=change-me-long-random-string
SUPERSET_DB_PASSWORD=superset_dev_pw
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# ---------- monitoring: Grafana ----------
GRAFANA_ADMIN_PASSWORD=admin

# ---------- catalog: OpenMetadata (optional) ----------
OPENMETADATA_VERSION=1.12.6
OM_DB_PASSWORD=openmetadata_dev_pw
OPENSEARCH_ADMIN_PASSWORD=Lakehouse_Dev_2026!
# UI -> Settings -> Bots -> ingestion-bot -> copy token, then `make catalog-ingest`
OM_JWT_TOKEN=
